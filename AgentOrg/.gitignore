# ── Secrets ──────────────────────────────────────────────────────────────────
# Real credentials never enter the repository. credentials.example.json is the
# committed template; credentials.json holds live keys and stays local.
credentials.json

# ── Runtimes ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ── Swift / SwiftPM ──────────────────────────────────────────────────────────
macos/.build/
macos/.swiftpm/
*.xcodeproj
*.xcworkspace
DerivedData/

# ── Generated run state ──────────────────────────────────────────────────────
# projects/ holds user workspaces: artifacts, trace.jsonl, run_state.json,
# session transcripts, telemetry spans and the effect journal.
projects/

# A run writes its generated plugins and context beside the manifest. For a *managed* workspace that
# is inside projects/, but an **attached** workspace is the user's own repository — so these landed in
# the repo root and showed up as untracked noise in a working tree the engine merely inhabits.
# Ignored by exact name because that is what the engine generates; the plan manifest (`<slug>.yaml`)
# is deliberately not matched, since its name comes from the goal and could be a real file of yours.
executor_run_*.py
guardrail_run_*.py
run-context.json
runner_state.json

# ── Telemetry and memory stores (may contain run content) ────────────────────
.agent_state/
.agent-run/
telemetry/

# ── Your own agents and skills ───────────────────────────────────────────────
# `.agentorg/` holds the roster you hired and any skills you authored. It is
# personal working state, not part of the project's source, so it stays local.
.agentorg/

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
