{
  "_comment": "AgentOrg credentials template. Copy to credentials.json and fill in. credentials.json is gitignored and must be chmod 0600. Prefer api_key_env over api_key so secrets never live in this file.",

  "version": "1.0.0",

  "providers": {
    "ollama": {
      "kind": "ollama",
      "base_url": "http://localhost:11434",
      "api_key": null,
      "api_key_env": null,
      "timeout_s": 300,
      "max_retries": 2,
      "model_aliases": {
        "qwen2.5-coder": "qwen2.5-coder:7b",
        "llama3": "llama3.1:8b"
      },
      "concurrency": 1
    },
    "lmstudio": {
      "kind": "openai",
      "base_url": "http://localhost:1234/v1",
      "api_key": null,
      "api_key_env": null,
      "timeout_s": 300,
      "max_retries": 2,
      "model_aliases": {},
      "concurrency": 1
    },
    "openai": {
      "kind": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key": null,
      "api_key_env": "OPENAI_API_KEY",
      "timeout_s": 120,
      "max_retries": 4,
      "model_aliases": {
        "gpt-4o": "gpt-4o-2024-11-20",
        "gpt-4o-mini": "gpt-4o-mini"
      },
      "concurrency": 4
    },
    "anthropic": {
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key": null,
      "api_key_env": "ANTHROPIC_API_KEY",
      "api_version": "2023-06-01",
      "timeout_s": 120,
      "max_retries": 4,
      "model_aliases": {
        "claude-sonnet": "claude-sonnet-4-20250514",
        "claude-haiku": "claude-haiku-4-20250514"
      },
      "concurrency": 3
    },
    "deepseek": {
      "kind": "openai",
      "base_url": "https://api.deepseek.com/v1",
      "api_key": null,
      "api_key_env": "DEEPSEEK_API_KEY",
      "timeout_s": 180,
      "max_retries": 3,
      "model_aliases": { "deepseek-chat": "deepseek-chat" },
      "concurrency": 3
    }
  },

  "models": {
    "_comment": "context_window and max_output are REQUIRED for any model an agent is bound to. A model with an unknown window is refused at binding time because the session projection depends on it. The live catalog can fill these in when the provider reports them.",
    "catalog": {
      "refresh_ttl_s": 900,
      "probe_on_add": true,
      "probe_capabilities": false,
      "offline_fallback": true
    },
    "known": {
      "claude-sonnet-4-20250514": { "context_window": 200000, "max_output": 8192, "locality": "cloud" },
      "claude-haiku-4-20250514":  { "context_window": 200000, "max_output": 8192, "locality": "cloud" },
      "gpt-4o-2024-11-20":         { "context_window": 128000, "max_output": 16384, "locality": "cloud" },
      "gpt-4o-mini":               { "context_window": 128000, "max_output": 16384, "locality": "cloud" },
      "deepseek-chat":             { "context_window": 65536,  "max_output": 8192, "locality": "cloud" },
      "qwen2.5-coder:7b":          { "context_window": 32768,  "max_output": 8192, "locality": "local" },
      "llama3.1:8b":               { "context_window": 131072, "max_output": 8192, "locality": "local" }
    }
  },

  "defaults": {
    "provider": "ollama",
    "model": "qwen2.5-coder:7b",
    "temperature": 0.2
  },

  "context": {
    "compact_at": 0.70,
    "evict_at": 0.85,
    "overflow_at": 0.95,
    "attention_floor": 0.30,
    "attention_lambda": 0.10,
    "max_rotations_per_node": 4,
    "rotate_on_phase_change": true,
    "output_reserve_frac": 0.15,
    "output_reserve_min": 1024,
    "output_reserve_max": 4096,
    "verbatim_markers": ["NEVER", "MUST NOT", "SECURITY", "AUTH", "COMPLIANCE"]
  },

  "concurrency": {
    "global_ceiling": null,
    "cpu_headroom": 1,
    "queue_max_depth": 64,
    "heartbeat_s": 30,
    "grace_s": 5,
    "stall_timeout_s": 1800,
    "per_provider_limits": { "ollama": 1, "lmstudio": 1, "openai": 4, "anthropic": 3, "deepseek": 3 }
  },

  "health": {
    "window_tasks": 20,
    "min_samples": 5,
    "healthy_at": 0.80,
    "degraded_at": 0.50,
    "hard_trigger_contract_breaches": 3,
    "quarantine_policy": "automatic",
    "probe_enabled": true,
    "retirement_idle_runs": 20
  },

  "slo": {
    "run": { "escalation_rate_target": 0.30, "cost_per_success_usd_target": 2.00 },
    "agent": { "success_rate_target": 0.85, "turn_latency_p95_ms_target": 60000 }
  },

  "delegation": {
    "max_depth": 3,
    "span_of_control": 5,
    "allow_ephemeral": true,
    "budget_share_max": 0.50,
    "anti_sprawl_window_runs": 5,
    "anti_sprawl_growth_threshold": 0.20,
    "approval_tiers": {
      "t0_max_tokens": 40000,
      "t1_max_tokens": 80000,
      "t2_max_tokens": 200000,
      "require_owner_above_usd": 0.0,
      "elevated_capability_markers": ["write:", "deploy:", "exec:", "admin:"]
    }
  },

  "budget": {
    "run_max_usd": 25.0,
    "run_max_tokens": 4000000,
    "org_max_usd_daily": 100.0
  },

  "policy": {
    "default_autonomy": {
      "R-CONTRACT": "auto",
      "R-REWORK": "auto",
      "R-DELEGATE": "auto",
      "R-ESCALATE": "confirm",
      "R-CONFLICT": "confirm",
      "R-MATCH-FAIL": "confirm"
    },
    "allow_autonomous_escalation": false,
    "router": { "threshold": 0.62, "margin": 0.15 }
  },

  "schemas": {
    "workspace": "1.0.0",
    "run_state": "1.0.0",
    "org": "1.0.0",
    "session_handoff": "1.0.0",
    "requisition": "1.0.0",
    "spans": "1.0.0"
  },

  "idempotency": { "journal": true, "hash_algorithm": "sha256" },

  "_comment_system": "Agents acting on this Mac. OFF by default, and enabling it grants nothing: it only makes the tools offerable. Each capability is a separate grant an agent must hold, and the allowlists are the scope of that grant. allow_full_access is the mode Reasonix calls bypassPermissions and Kimi --auto: no allowlists and no consent prompt, for a machine you have handed over. It still requires enabled, still requires the agent's grant, still bounds every call, and still records every action.",
  "system": {
    "enabled": false,
    "allow_apps": [],
    "allow_automation": [],
    "screenshot_dir": "",
    "max_seconds": 20,
    "max_output_bytes": 40000,
    "allow_full_access": false
  },

  "library": {
    "root": null,
    "commit": null,
    "manifest": null
  },

  "telemetry": {
    "spans_path": null,
    "sample_default": 1.0,
    "sample_on_escalation": 1.0,
    "export_enabled": true
  }
}
